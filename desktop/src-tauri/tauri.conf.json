{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LedgerVoid",
  "version": "0.1.0",
  "identifier": "com.ayushasb9.ledgervoid",
  "build": {
    "frontendDist": "https://ledgervoid.onrender.com"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Financial intelligence for annual reports",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
